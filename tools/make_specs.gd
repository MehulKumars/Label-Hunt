## Turns data/rooms/curve.json into data/rooms/roomN_spec.json for every generated room (not the hand-made ones),
## with the sawtooth per pack of 10: 1-4 rise, 5 tricky, 6 rest (brings the room's new idea), 7-9 rise, 10 hard.
## Run: godot --headless --path . -s res://tools/make_specs.gd [-- --rooms=3-17]
extends SceneTree

const CURVE := "res://data/rooms/curve.json"
const SPEC := "res://data/rooms/room%d_spec.json"
const INTRO_POS := 6


func _init() -> void:
	var curve: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(CURVE))
	var only: Array[int] = []
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--rooms="):
			for part in a.substr(8).split(","):
				if part.contains("-"):
					for x in range(int(part.get_slice("-", 0)), int(part.get_slice("-", 1)) + 1):
						only.append(x)
				else:
					only.append(int(part))
	for row: Dictionary in curve["rooms"]:
		var room := int(row["room"])
		if row.get("hand", false) or (not only.is_empty() and not only.has(room)):
			continue
		var levels: Array = []
		for pos in range(1, 31):
			levels.append(level_spec(curve, row, pos))
		JsonOut.write(SPEC % room, {"room": room, "name": row["name"], "note": "Generated by tools/make_specs.gd from data/rooms/curve.json; edit the curve, not this file.", "levels": levels})
		print("room %d: %s" % [room, row["name"]])
	quit()


static func kind_at(pos: int) -> String:
	match (pos - 1) % 10 + 1:
		5: return "tricky"
		6: return "rest"
		10: return "hard"
	return "normal"


static func level_spec(curve: Dictionary, row: Dictionary, pos: int) -> Dictionary:
	var room := int(row["room"])
	var at := Ledger.global_number(room, pos)
	var kind := kind_at(pos)
	var intro: String = row.get("intro", "")
	var is_intro := intro != "" and pos == INTRO_POS
	var late := intro != "" and pos >= INTRO_POS
	var groups := int(_pick(row, "groups", late)[kind])
	var t3 := int(row["t3"][kind])
	var t2 := int(row["t2"][kind])
	var herrings := int(_pick(row, "herrings", late)[kind])
	if is_intro:
		# The intro level shows the new idea on a breather: the late group count with rest-level tiers.
		groups = int(_pick(row, "groups", true)["normal"])
		t3 = 0
		t2 = 1
		herrings = int(_pick(row, "herrings", true)["rest"]) if intro == "double" else 0
		if intro == "wordplay":
			t3 = 1
	# Within a pack the middle levels get one more tier-2 group on even positions (the rise).
	if kind == "normal" and pos % 2 == 0:
		t2 += 1
	t3 = mini(t3, groups)
	t2 = mini(t2, groups - t3)
	var tiers: Array = []
	for i in groups - t3 - t2:
		tiers.append(1)
	for i in t2:
		tiers.append(2)
	for i in t3:
		tiers.append(3)
	var exclude: Array = []
	if at < int(curve["abstract_from"]):
		exclude.append("abstract")
	if at < int(curve["wordplay_from"]):
		exclude.append("wordplay")
	elif t3 > 0:
		var every := int(row.get("t4_every", 0))
		if (intro == "wordplay" and pos == INTRO_POS) or (every > 0 and pos % every == 0):
			tiers[tiers.size() - 1] = 4
	var t: Dictionary = curve["target"]
	var spec := {
		"kind": kind, "tiers": tiers, "herrings": herrings, "budget": true,
		"floor": float(row["floor"][kind]), "novice_floor": float(row.get("novice_floor", 0.0)),
		"target": snappedf((float(t["base"]) + float(t["per_level"]) * at) * float(t[kind]), 0.01),
	}
	if not exclude.is_empty():
		spec["exclude"] = exclude
	if is_intro:
		spec["introduces"] = [intro]
	for special in ["frost", "labelled", "corked"]:
		if row.has(special):
			var sp: Dictionary = row[special]
			var from := int(sp["from"])
			if pos >= from and (pos - from) % int(sp["every"]) == 0 and (kind != "rest" or is_intro):
				spec[special] = int(sp["value"])
	return spec


static func _pick(row: Dictionary, key: String, late: bool) -> Dictionary:
	if late and row.has(key + "_late"):
		return row[key + "_late"]
	return row[key]
