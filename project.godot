; Engine configuration file.
; Godot rewrites this file; keep hand edits small.

config_version=5

[application]

config/name="Label Hunt"
config/description="Sort word cards into jars by their hidden category."
config/version="0.6.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/max_fps=60
boot_splash/bg_color=Color(1, 0.972549, 0.92549, 1)
boot_splash/show_image=false

[autoload]

Levels="*res://src/core/levels.gd"
Save="*res://src/core/save.gd"
Wallet="*res://src/core/wallet.gd"

Sfx="*res://src/core/sfx.gd"
Haptics="*res://src/core/haptics.gd"
Ads="*res://src/core/ads.gd"
Store="*res://src/core/store.gd"
Social="*res://src/core/social.gd"


[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=960
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
